{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TekPair",
  "version": "0.1.0",
  "identifier": "tech.tekpair.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TekPair",
        "url": "https://www.tekpair.tech/app.html",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TekPair",
    "category": "Business",
    "shortDescription": "TekPair con impresión nativa",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
