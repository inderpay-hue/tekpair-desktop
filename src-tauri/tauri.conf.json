      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4OEU2RjBEQjBCMkQwRDcKUldUWDBMS3dEVytPV0kvT1FISnNHVUhST3hFR0pBaUsyb2NxQk5NMXl6TGNkbXZMbWcyZjEzdEUK",
      "endpoints": [
        "https://github.com/inderpay-hue/tekpair-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
