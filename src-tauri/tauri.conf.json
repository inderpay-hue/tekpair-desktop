{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TekPair",
  "version": "0.3.1",
  "identifier": "tech.tekpair.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TekPair",
        "url": "https://www.tekpair.tech/app.html",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
