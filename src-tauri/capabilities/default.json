{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permite que la web remota de TekPair (tekpair.tech) use el IPC nativo para imprimir y abrir enlaces de fuera.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://www.tekpair.tech/*",
      "https://tekpair.tech/*",
      "https://*.tekpair.tech/*"
    ]
  },
  "permissions": [
    "core:default",
    "impresion-nativa",
    "enlaces-externos"
  ]
}
